{
  "name": "@vexor-push/react-native-code-push",
  "version": "0.3.0",
  "description": "Vexor React Native CodePush SDK for self-hosted OTA updates.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
